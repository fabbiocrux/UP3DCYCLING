@article{pflitsch2026,
  title = {Rethinking the {{Third Mission}}: {{Organizing}} Dissonance in Transformative Universities},
  shorttitle = {Rethinking the {{Third Mission}}},
  author = {Pflitsch, Gesa and Menzel, Max-Peter},
  date = {2026-03-01},
  journaltitle = {Research Policy},
  shortjournal = {Res. Policy},
  volume = {55},
