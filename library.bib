@article{zhu2026,
  title = {Explainable {{AI}} Analysis of Printing Parameter Effects on Life Cycle Assessment for Sustainable Material-Extrusion Additive Manufacturing},
  author = {Zhu, Yanlong and Abali, Bilen Emek and V\"ollmecke, Christina},
  date = {2026-02-22},
  journaltitle = {Virtual and Physical Prototyping},
