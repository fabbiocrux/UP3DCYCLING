@article{perea2023,
  title = {Digital Sobriety: {{From}} Awareness of the Negative Impacts of {{IT}} Usages to Degrowth Technology at Work},
  shorttitle = {Digital Sobriety},
  author = {P\'er\'ea, C\'eline and G\'erard, Jessica and family=Benedittis, given=Julien, prefix=de, useprefix=true},
