@article{kasznik2023,
  title = {The End of Plastic? {{The EU}}'s Directive on Single-Use Plastics and Its Implementation in {{Poland}}},
  shorttitle = {The End of Plastic?},
  author = {Kasznik, Dominika and \L apniewska, Zofia},
  date = {2023-07-01},
  journaltitle = {Environmental Science \& Policy},
