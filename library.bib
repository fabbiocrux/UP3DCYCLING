  file = {/Users/FabioCruz/Zotero/storage/2AXU3SVI/Ghosh et al_2022_The Circular Economy Life Cycle Assessment and Visualization Framework.pdf;/Users/FabioCruz/Zotero/storage/9ZW5YEV7/S0921344922003676.html}
