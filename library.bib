@article{stock-homburg2021,
  title = {Need-Solution Pair Recognition by Household Sector Individuals: {{Evidence}}, and a Cognitive Mechanism Explanation},
  author = {Stock-Homburg, Ruth M. and Heald, Shannon L.M. and Holthaus, Christian and Gillert, Nils Lennart and family=Hippel, given=Eric, prefix=von, useprefix=false},
  date = {2021-07-23},
  journaltitle = {Research Policy},
