  author = {Le Marec, Pierre Erwan and Ferry, Laurent and Quantin, Jean-Christophe and B\'en\'ezet, Jean-Charles and Bonfils, Fr\'ed\'eric and Guilbert, St\'ephane and Bergeret, Anne},
