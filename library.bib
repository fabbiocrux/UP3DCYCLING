@article{vandeventer2024,
  title = {What Does Degrowth Do in/to Empirical Research? {{Methodological}} Deliberations on Placing Degrowth `in the World'},
  shorttitle = {What Does Degrowth Do in/to Empirical Research?},
  author = {Vandeventer, James Scott and Schmid, Benedikt},
  date = {2024-07-01},
  journaltitle = {Ecological Economics},
  shortjournal = {Ecol. Econ.},
