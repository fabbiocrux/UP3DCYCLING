@article{makinen-rostedt2025,
  title = {Expert Knowledge and Institutional Interplay: {{Exploring}} the Epistemic Linkages of the {{IPCC}}, {{IPBES}}, {{WCRP}}, and {{Future Earth}}},
  shorttitle = {Expert Knowledge and Institutional Interplay},
  author = {M\"akinen-Rostedt, Katri and Oreschnikoff, Aleksis and Uusikyl\"a, Petri},
