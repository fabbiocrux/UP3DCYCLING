@article{emami2026,
  title = {Material Flow Analysis of Plastics in {{Australia}}: {{Towards}} a Circular Economy of Polymers},
  shorttitle = {Material Flow Analysis of Plastics in {{Australia}}},
  author = {Emami, Nargessadat and Nguyen, Quoc Anh and Miatto, Alessio and Fry, Jacob and Taskhiri, Mohammad Sadegh and Li, Mengyu and Lenzen, Manfred and Lau, Deborah and Schandl, Heinz},
  date = {2026-03-01},
  journaltitle = {Resources, Conservation and Recycling},
