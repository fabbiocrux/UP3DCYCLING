@article{nikiema2022,
  title = {A Review of the Cost and Effectiveness of Solutions to Address Plastic Pollution},
  author = {Nikiema, Josiane and Asiedu, Zipporah},
  date = {2022-04-01},
  journaltitle = {Environmental Science and Pollution Research},
  shortjournal = {Environ. Sci. Pollut. Res.},
