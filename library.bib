  volume = {204},
  pages = {107472},
  issn = {0921-3449},
  doi = {10.1016/j.resconrec.2024.107472},
  url = {https://www.sciencedirect.com/science/article/pii/S0921344924000661},
  urldate = {2024-02-18},
  abstract = {The management of municipal solid waste can have major environmental impacts. However, waste generation patterns have generally not been thoroughly analyzed, leading to an overall poor understanding of waste generation trends. Here, we quantify changes in waste generation that occur on different scales: from day-to-day, season-to-season, year-to-year, and over relatively small geographic areas using a well-defined residential waste stream data set. Findings indicate greater waste generation and disposal amounts on weekends versus weekdays, and summer compared to winter, and a monotonic decline in waste generation from 2004 to 2017, resulting in decreases in disposal and waste generation rates of more than 25 \%. Waste generation and disposal rates decrease and recycling increases with greater levels of education, income, and house values, and ethnicity differences also correlate to waste management patterns. More informed understanding of the nature of waste generation patterns can improve overall waste management practices and planning, potentially leading to better public policies addressing broader issues in resource management and climate change.},
  file = {/Users/FabioCruz/Zotero/storage/BTCMBBU7/S0921344924000661.html}
}

@article{fischer2016,
  title = {Importance of Actors and Agency in Sustainability Transitions: {{A}} Systematic Exploration of the Literature},
  author = {Fischer, Lisa Britt and Newig, Jens},
  date = {2016},
  journaltitle = {Sustainability (Switzerland)},
  shortjournal = {Sustain. Switz.},
  volume = {8},
  number = {5},
  publisher = {MDPI},
  issn = {20711050},
  doi = {10.3390/SU8050476},
  abstract = {This article explores the role of actors and agency in the literature on sustainability transitions. We reviewed 386 journal articles on transition management and sustainability transitions listed in Scopus from 1995 to 2014. We investigate the thesis that actors have been neglected in this literature in favor of more abstract system concepts. Results show that this thesis cannot be confirmed on a general level. Rather, we find a variety of different approaches, depending on the systemic level, for clustering actors and agency as niche, regime, and landscape actors; the societal realm; different levels of governance; and intermediaries. We also differentiate between supporting and opposing actors. We find that actor roles in transitions are erratic, since their roles can change over the course of time, and that actors can belong to different categories. We conclude by providing recommendations for a comprehensive typology of actors in sustainability transitions.}
}

@article{fischer2021,
  title = {Sustainable Consumption Communication: {{A}} Review of an Emerging Field of Research},
  author = {Fischer, Daniel and Reinermann, Julia-Lena and Guillen Mandujano, Georgina and DesRoches, C. Tyler and Diddi, Sonali and Vergragt, Philip J.},
  date = {2021-06-01},
  journaltitle = {Journal of Cleaner Production},
  shortjournal = {J. Clean. Prod.},
  volume = {300},
  pages = {126880},
  publisher = {Elsevier BV},
  issn = {09596526},
  doi = {10.1016/j.jclepro.2021.126880},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S0959652621010994},
  urldate = {2021-04-29},
  abstract = {Communication plays an important role in promoting sustainable consumption. Yet how the academic literature conceptualizes and relates communication and sustainable consumption remains poorly understood, despite growing research on communication in the context of sustainable consumption. This article presents the first comprehensive review of sustainable consumption communication (SCC) research as a young and evolving field of scholarly work. Through a systematic review and narrative synthesis of N = 67 peer-reviewed journal articles, we consolidated the research conducted in this field into four distinct types: communication as an approach to (1) behavior change, (2) self-empowerment, (3) systems change, and (4) reflection on current discourses and practices around sustainable consumption. Our findings reveal that most journal articles focus on incremental changes in individual consumer behavior (``weak'' sustainable consumption) and employ communication as an intervention tool with little reference to communication science and theory. They also reveal integration challenges arising from the disciplinary diversity and fragmentation characteristic of the research field. Future research should develop shared frameworks and terminology, diversify its foci, synthesize relevant evidence, and innovate critical perspectives that go beyond one-way business-to-consumer communication. The results of our review can serve researchers engaged in sustainable consumption communication to better systematize their efforts and contribute more effectively to changing systems of consumption in the future.},
  file = {/Users/FabioCruz/Zotero/storage/CXTTPX4P/full-text.pdf}
}

