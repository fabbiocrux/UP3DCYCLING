@article{gok2014,
  title = {Optimization of Processing Parameters of a Developed New Driller System for Orthopedic Surgery Applications Using {{Taguchi}} Method},
  author = {Gok, Kadir and Gok, Arif and Kisioglu, Yasin},
  date = {2014},
  journaltitle = {International Journal of Advanced Manufacturing Technology},
  shortjournal = {Int. J. Adv. Manuf. Technol.},
