@article{biggs2012,
  title = {Toward {{Principles}} for {{Enhancing}} the {{Resilience}} of {{Ecosystem Services}}},
  author = {Biggs, Reinette and Schl\"uter, Maja and Biggs, Duan and Bohensky, Erin L. and BurnSilver, Shauna and Cundill, Georgina and Dakos, Vasilis and Daw, Tim M. and Evans, Louisa S. and Kotschy, Karen and Leitch, Anne M. and Meek, Chanda and Quinlan, Allyson and Raudsepp-Hearne, Ciara and Robards, Martin D. and Schoon, Michael L. and Schultz, Lisen and West, Paul C.},
