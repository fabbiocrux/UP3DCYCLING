@article{kerschner2018,
  title = {Degrowth and {{Technology}}: {{Towards}} Feasible, Viable, Appropriate and Convivial Imaginaries},
  shorttitle = {Degrowth and {{Technology}}},
  author = {Kerschner, Christian and W\"achter, Petra and Nierling, Linda and Ehlers, Melf-Hinrich},
  date = {2018-10-01},
  journaltitle = {Journal of Cleaner Production},
