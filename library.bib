@article{suescungonzalez2024,
  title = {Multi-Material Distributed Recycling via Material Extrusion: Recycled High Density Polyethylene and Poly (Ethylene Terephthalate) Mixture},
  shorttitle = {Multi-Material Distributed Recycling via Material Extrusion},
  author = {Suescun Gonzalez, Catalina and Cruz Sanchez, Fabio A. and Boudaoud, Hakim and Nouvel, C\'ecile and Pearce, Joshua M.},
