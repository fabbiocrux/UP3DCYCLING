@article{depascale2023,
  title = {The Circular Economy Implementation at the {{European Union}} Level. {{Past}}, Present and Future},
  author = {De Pascale, Angelina and Di Vita, Giuseppe and Giannetto, Carlo and Ioppolo, Giuseppe and Lanfranchi, Maurizio and Limosani, Michele and Szopik-Depczy\'nska, Katarzyna},
  date = {2023-10-15},
