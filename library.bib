@article{mancuso2025,
  title = {The Bright and Dark Sides of {{AI}} Innovation for Sustainable Development: {{Understanding}} the Paradoxical Tension between Value Creation and Value Destruction},
  shorttitle = {The Bright and Dark Sides of {{AI}} Innovation for Sustainable Development},
  author = {Mancuso, Ilaria and Petruzzelli, Antonio Messeni and Panniello, Umberto and Vaia, Giovanni},
  date = {2025-05-01},
  journaltitle = {Technovation},
  volume = {143},
