@article{tanikella2017,
  title = {Tensile Strength of Commercial Polymer Materials for Fused Filament Fabrication {{3D}} Printing},
  author = {Tanikella, Nagendra G. and Wittbrodt, Ben and Pearce, Joshua M.},
  date = {2017-05},
  journaltitle = {Additive Manufacturing},
  shortjournal = {Addit. Manuf.},
  volume = {15},
