  doi = {10.1016/j.envsci.2026.104405},
  url = {https://www.sciencedirect.com/science/article/pii/S1462901126001000},
  urldate = {2026-06-17},
  abstract = {The international scientific community has made outstanding progress in integrating diverse academic disciplines to tackle complex sustainability problems. The challenge of our time is integrating non-academic knowledge from the "real world" towards transdisciplinary research. Further examination of transdisciplinary projects implemented in the Global South is crucial for identifying what challenges stand out in relation to the transdisciplinary literature, mostly based on experiences held in the global north. This article aims to help fill this gap by transversally analyzing the experience of more than 100 researchers across 6 study sites, who have contributed to a 7-year-long project in Brazil, focusing on the socio-environmental dynamics of communities vulnerable to climate change. We present the recurring challenges and opportunities recognized by the researchers involved in the project and reflect on their interaction with different types of societal actors. We recognize that many of the key points highlighted by the researchers reflect characteristics that are common to transdisciplinary practice elsewhere but that one critical component emerges: the urge felt by researchers in translating local demands into policy. We argue that a crucial benefit of transdisciplinary science in contexts where marginalized populations have little to no access to public policy and decision making is the production of bridges that create communication flows from communities to policy. We conclude by advocating for the role of transdisciplinary research in translating grassroots demands into climate action and indicating pathways for future research.},
  file = {/Users/FabioCruz/Zotero/storage/ZRL7L68V/S1462901126001000.html}
}

