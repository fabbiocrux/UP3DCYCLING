  author = {Carlsson Reich, Marcus},
  date = {2005-02-01},
  journaltitle = {Journal of Cleaner Production},
  shortjournal = {J. Clean. Prod.},
  series = {Environmental {{Assessments}} and {{Waste Management}}},
