@article{weiss2012,
  title = {A {{Review}} of the {{Environmental Impacts}} of {{Biobased Materials}}},
  author = {Weiss, Martin and Haufe, Juliane and Carus, Michael and Brand??o, Miguel and Bringezu, Stefan and Hermann, Barbara and Patel, Martin K.},
