@article{rebolledo-leiva2023,
  title = {Attributional and Consequential Life Cycle Perspectives of Second-Generation Polylactic Acid: {{The}} Benefits of Integrating a Recycling Strategy},
  shorttitle = {Attributional and Consequential Life Cycle Perspectives of Second-Generation Polylactic Acid},
  author = {Rebolledo-Leiva, Ricardo and Ladakis, Dimitrios and Ioannidou, Sofia-Maria and Koutinas, Apostolis and Moreira, Maria Teresa and Gonz\'alez-Garc\'ia, Sara},
