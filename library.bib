@article{bachmann2023,
  title = {Towards Circular Plastics within Planetary Boundaries},
  author = {Bachmann, Marvin and Zibunas, Christian and Hartmann, Jan and Tulus, Victor and Suh, Sangwon and Guill\'en-Gos\'albez, Gonzalo and Bardow, Andr\'e},
  date = {2023-05},
  journaltitle = {Nature Sustainability},
