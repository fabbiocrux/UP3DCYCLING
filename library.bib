@article{wijsman2022,
  title = {What Do We Mean by Justice in Sustainability Pathways? {{Commitments}}, Dilemmas, and Translations from Theory to Practice in Nature-Based Solutions.},
  shorttitle = {What Do We Mean by Justice in Sustainability Pathways?},
  author = {Wijsman, Katinka and Berb\'es-Bl\'azquez, Marta},
  date = {2022-10-01},
