@article{maher2023,
  title = {Circular Economy 4 Business: {{A}} Program and Framework for Small-to-Medium Enterprises ({{SMEs}}) with Three Case Studies},
  shorttitle = {Circular Economy 4 Business},
  author = {Maher, Ray and Yarnold, Jennifer and Pushpamali, N. N. C.},
