@article{house2024,
  title = {The Politics of Transdisciplinary Research on Societal Transitions},
  author = {House, Jonas and Davis, Natalie and Dermody, Brian J. and family=Horst, given=Hilje, prefix=van der, useprefix=true and Praasterink, Frederike and Wertheim-Heck, Sigrid},
