@article{stansbury2016,
  title = {{{3D}} Printing with Polymers: {{Challenges}} among Expanding Options and Opportunities},
  author = {Stansbury, Jeffrey W. and Idacavage, Mike J.},
  date = {2016-01},
  journaltitle = {Dental Materials},
  shortjournal = {Dent. Mater.},
  volume = {32},
  number = {1},
  eprint = {26494268},
