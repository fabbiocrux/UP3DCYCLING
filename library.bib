@article{villarrubia-gomez2018,
  title = {Marine Plastic Pollution as a Planetary Boundary Threat -- {{The}} Drifting Piece in the Sustainability Puzzle},
  author = {Villarrubia-G\'omez, Patricia and Cornell, Sarah E. and Fabres, Joan},
  date = {2018-10-01},
  journaltitle = {Marine Policy},
  shortjournal = {Mar. Policy},
  volume = {96},
  pages = {213--220},
  issn = {0308-597X},
  doi = {10.1016/j.marpol.2017.11.035},
  url = {https://www.sciencedirect.com/science/article/pii/S0308597X17305456},
  urldate = {2022-09-26},
  abstract = {The exponential increase in the use of plastic in modern society and the inadequate management of the resulting waste have led to its accumulation in the marine environment. There is increasing evidence of numerous mechanisms by which marine plastic pollution is causing effects across successive levels of biological organization. This will unavoidably impact ecological communities and ecosystem functions. A remaining question to be answered is if the concentration of plastic in the ocean, today or in the future, will reach levels above a critical threshold leading to global effects in vital Earth-system processes, thus granting the consideration of marine plastic pollution as a key component of the planetary boundary threat associated with chemical pollutants. Possible answers to this question are explored by reviewing and evaluating existing knowledge of the effects of plastic pollution in marine ecosystems and the `core planetary boundaries', biosphere integrity and climate change. The irreversibility and global ubiquity of marine plastic pollution mean that two essential conditions for a planetary boundary threat are already met. The Earth system consequences of plastic pollution are still uncertain, but pathways and mechanisms for thresholds and global systemic change are identified. Irrespective of the recognition of plastic as a novel entity in the planetary boundaries framework, it is certain that marine plastic pollution is closely intertwined with global processes to a point that deserves careful management and prevention.},
  langid = {english},
  file = {/Users/FabioCruz/Zotero/storage/SLNW297G/Villarrubia-Gómez et al_2018_Marine plastic pollution as a planetary boundary threat – The drifting piece in.pdf;/Users/FabioCruz/Zotero/storage/WTHHDTEA/S0308597X17305456.html}
}

@article{villarrubia-gomez2024,
  title = {Plastics Pollution Exacerbates the Impacts of All Planetary Boundaries},
  author = {Villarrubia-G\'omez, Patricia and Carney Almroth, Bethanie and Eriksen, Marcus and Ryberg, Morten and Cornell., Sarah E.},
  date = {2024-12-20},
  journaltitle = {One Earth},
