@article{dasilva2018,
  title = {Public Policy for Solid Waste and the Organization of Waste Pickers: {{Potentials}} and Limitations to Promote Social Inclusion in {{Brazil}}},
  author = {family=Silva, given=Christian Luiz, prefix=da, useprefix=true and Bolson, Camille},
