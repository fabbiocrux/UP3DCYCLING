@article{kumar2025,
  title = {Designing Cost-Effective Supply Chains for Plastics at the End-of-Life},
  author = {Kumar, Baibhaw and Pimentel, Jean and Cano-Londo\~no, Natalia A. and Ruiz-Mercado, Gerardo J. and Deak, Csaba T. and Cabezas, Heriberto},
