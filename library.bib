@article{janssen,
  title = {Renewable {{Methacrylate Resins}} for {{3D Printing Containing Dynamic Hydroxyester Linkages}} for {{Reprocessability}}},
  author = {Janssen, Kylian and Schnelting, Geraldine H.M. and Waterink, Mirte and Guit, Jarno and Hul, Jerzy and Ye, Chongnan and Loos, Katja and Voet, Vincent S.D.},
  journaltitle = {Macromolecular Materials and Engineering},
  shortjournal = {Macromol. Mater. Eng.},
  volume = {n/a},
