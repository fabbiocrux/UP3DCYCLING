@article{dadamo2022,
  title = {Assessing the Relation between Waste Management Policies and Circular Economy Goals},
  author = {D'Adamo, Idiano and Mazzanti, Massimiliano and Morone, Piergiuseppe and Rosa, Paolo},
  date = {2022-12-01},
  journaltitle = {Waste Management},
