@article{cordella2023,
  title = {Addressing Sustainable Development Goals in Life Cycle Sustainable Assessment: {{Synergies}}, Challenges and Needs},
  shorttitle = {Addressing Sustainable Development Goals in Life Cycle Sustainable Assessment},
  author = {Cordella, Mauro and Horn, Rafael and Hong, Sun Hea and Bianchi, Marco and Isasa, Marina and Harmens, Rosan and Sonderegger, Thomas and Pihkola, Hanna},
