@article{ogink2022,
  title = {Mechanisms in Open Innovation: {{A}} Review and Synthesis of the Literature},
  shorttitle = {Mechanisms in Open Innovation},
  author = {Ogink, Ruben H. A. J. and Goossen, Martin C. and Romme, A. Georges L. and Akkermans, Henk},
  date = {2022-09-14},
  journaltitle = {Technovation},
