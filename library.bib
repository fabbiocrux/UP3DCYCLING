@article{pieroni2021,
  title = {An Expert System for Circular Economy Business Modelling: Advising Manufacturing Companies in Decoupling Value Creation from Resource Consumption},
  author = {Pieroni, Marina P.P. and McAloone, Tim C. and Borgianni, Yuri and Maccioni, Lorenzo and Pigosso, Daniela C.A.},
  date = {2021-07-01},
  journaltitle = {Sustainable Production and Consumption},
  shortjournal = {Sustain. Prod. Consum.},
  volume = {27},
  pages = {534--550},
  publisher = {Elsevier B.V.},
  issn = {23525509},
  doi = {10.1016/j.spc.2021.01.023},
  abstract = {Shortcomings in manufacturing companies' capabilities to execute circular economy business modelling have delayed a broader dissemination of circular business models beyond the stage of pilot projects in niche markets. Circular economy poses additional uncertainties for innovation that are not common for manufacturing companies' traditional activities and business as usual. To cope with such challenges, they lack systematised practices and proactive advice, which are scant in available literature and approaches. The paper presents the development of the tool Circular Economy Business Modelling Expert System within manufacturing companies, intended to address these limitations. Based on systematised business modelling practices for circular economy and proactive advice on potential circular business model configurations, the expert system enhances strategic thinking for circular economy, supporting companies to come up with varied alternative business models with reasonable and viable value propositions to deploy circular benefits accordingly. The expert system was streamlined based on literature review, development, testing and evaluation with 12 practitioners from 10 companies. The paper discusses the main functionalities of the expert system and the results of its application into varied manufacturing companies. The application of the expert system has demonstrated to benefit companies with: inspiration for best practices on circular business modelling, a structured framework for confirming assumptions and a logic structure that prompts decision-making and reduces uncertainties.}
}

@article{pierrel2025,
  title = {From {{Complexity}} to {{Clarity}}: {{Eden3}}'s {{Novel Perspective}} on {{Limits}} to {{Growth}}},
  shorttitle = {From {{Complexity}} to {{Clarity}}},
  author = {Pierrel, Capucine and Nguyen-Huu, Adrien and Gaucherel, C\'edric},
  date = {2025-03-31},
  journaltitle = {Futures},
  pages = {103597},
  issn = {0016-3287},
  doi = {10.1016/j.futures.2025.103597},
  url = {https://www.sciencedirect.com/science/article/pii/S001632872500059X},
  urldate = {2025-04-07},
  abstract = {Fifty years after the publication of Limits to Growth (LtG), its scenarios predicting global socio-economic collapse are still relevant. In this study, we extracted key components and processes from the LtG narratives to construct a simple qualitative model based on solely 13 variables and 40 qualitative rules. Our modeling framework enables the computation of all possible system trajectories (scenarios) within a single output once the model is accepted. By retracing all scenarios presented in LtG, our model uncovered highly interconnected trajectories leading to either sustainability or collapse. Through this work, we demonstrate that the co-authors of LtG successfully tackled the challenge of exhaustively representing all conceivable trajectories for the global system based on their core assumptions. Furthermore, our study paves the way for exploring alternative scenarios by applying this comprehensive, yet straightforward framework to newly acquired knowledge.},
  file = {/Users/FabioCruz/Zotero/storage/28EST5PM/S001632872500059X.html}
}

@article{pietraru2026,
  title = {Natural Sciences for Post-Growth in Practice: Low-Tech Iron Oxide Reduction under a Concentrated Light Flux Using Urine-Derived Ammonia and Hydrogen as Reducers},
  shorttitle = {Natural Sciences for Post-Growth in Practice},
  author = {Pietraru, Marie-H\'el\`ene and Luu, Marion and Smit, Jorrit P. and Lachaize, S\'ebastien and Carrey, Julian},
  date = {2026-09-20},
  journaltitle = {Journal of Cleaner Production},
  shortjournal = {J. Clean. Prod.},
  volume = {576},
  pages = {149114},
  issn = {0959-6526},
  doi = {10.1016/j.jclepro.2026.149114},
  url = {https://www.sciencedirect.com/science/article/pii/S0959652626016550},
  urldate = {2026-09-20},
  abstract = {A telling example of the green growth sociotechnical imaginary in natural sciences is the future of `green' steel production, envisaged to grow based on a hypothetical massive deployment of low-carbon electricity. In this article, we show how a post-growth, low-tech framework can open up new innovation pathways towards sustainable futures of ironmaking. The low-tech processes that we envision aim at converting iron oxide into iron using readily available and renewable sources of reducing agents and energy: ammonia and hydrogen from urine, and concentrated sunlight. In our study, a solar concentrator simulator and synthetic urea were used as models to assess two ways of generating ammonia from urea for iron oxide reduction: i) the pyrolysis of solid urea inside the reduction reactor under concentrated light flux, and ii) the biocatalysed hydrolysis of urea by addition of urease-rich plant seeds -- like soybeans or watermelon seeds -- to an aqueous solution of urea mimicking urine. During the reduction of iron oxide, in situ mass spectrometry confirmed the decomposition of ammonia into hydrogen in presence of iron species. X-ray diffraction analysis of the resulting samples showed that the reduction yield successfully reached 90--98\%. The global level of production of iron of such a process would be limited by urine production; estimates are provided and discussed. Parting from the green growth imaginary, our interdisciplinary work aims at reintegrating chemical processes into natural cycles, independent from both electricity and fossil fuels, and also at participating in opening up research to more diverse visions of the future.},
  file = {/Users/FabioCruz/Zotero/storage/U6SIH4IM/Pietraru et al. - 2026 - Natural sciences for post-growth in practice low-tech iron oxide reduction under a concentrated lig.pdf;/Users/FabioCruz/Zotero/storage/CBZDMEPN/S0959652626016550.html}
}

@article{pietzsch2017,
  title = {Benefits, Challenges and Critical Factors of Success for {{Zero Waste}}: {{A}} Systematic Literature Review},
  author = {Pietzsch, Nat\'alia and Ribeiro, Jos\'e Luis Duarte and family=Medeiros, given=Janine Fleith, prefix=de, useprefix=true},
  date = {2017-09-01},
  journaltitle = {Waste Management},
  shortjournal = {Waste Manag.},
  volume = {67},
  pages = {324--353},
  publisher = {Pergamon},
  issn = {0956-053X},
  doi = {10.1016/J.WASMAN.2017.05.004},
  abstract = {Considering the growing concern with solid wastes problems and the pressing need for a holistic approach to their management, this study developed a literature review about the subject ``Zero Waste''. To that end, a systematic literature review was executed, through which 102 published articles were analyzed with the aim to, initially, comprehend the concept of Zero Waste, and, then, map its benefits, challenges, and critical success factors. The results show that scholars have not reached a consensus regarding the concept of ZW. While some studies fully address this philosophy, other studies are based on just one or on some of its topics. The benefits were grouped and organized into four dimensions: benefits to the community, financial-economic benefits, benefits to the environment and benefits to the industry and stakeholders. As to the challenges, barriers were identified both in the macro environment (mainly political and cultural) and in the meso and micro environments (stakeholders, industries, and municipalities). The analysis of the articles enabled listing critical success factors, supported by a set of activities that must be carried out. Regarding future studies, it is worth noting that more empirical studies about ZW implementation are necessary, particularly with regard to educational practices designed to promote changes in user behavior.}
}

