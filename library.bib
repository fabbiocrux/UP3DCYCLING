@article{brock2026,
  title = {The Can Challenge: {{Understanding}} the Best Ways to Incentivise Recycling through a Diffusion Approach},
  shorttitle = {The Can Challenge},
  author = {Brock, Michael and Murgia, Lucia M. and Sitzia, Stefania and Zheng, Jiwei},
