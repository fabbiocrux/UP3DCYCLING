@article{agrawal2020,
  title = {Sustainability Evaluation of Additive Manufacturing Processes Using Grey-Based Approach},
  author = {Agrawal, Rohit and S., Vinodh},
  date = {2020-01-17},
  journaltitle = {Grey Systems: Theory and Application},
  shortjournal = {Grey Syst. Theory Appl.},
  volume = {10},
