@article{moreno-camacho2019,
  title = {Sustainability Metrics for Real Case Applications of the Supply Chain Network Design Problem: {{A}} Systematic Literature Review},
  author = {Moreno-Camacho, Carlos A and Montoya-Torres, Jairo R and Jaegler, Anicia and Gondran, Natacha},
