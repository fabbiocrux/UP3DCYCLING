@article{vantklooster2024,
  title = {Foresight in Action: {{A}} Longitudinal Study Based on a 25-Year Journey in the World of Policy-Oriented Foresight},
  shorttitle = {Foresight in Action},
  author = {family=`t Klooster, given=S. A., prefix=van, useprefix=true and Cramer, T. and family=Asselt, given=M. B. A., prefix=van, useprefix=true},
  date = {2024-01-01},
  journaltitle = {Futures},
  volume = {155},
