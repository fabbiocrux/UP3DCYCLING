@article{poulson1996,
  title = {{{USERfit}}: {{A}} Practical Handbook on User-Centred Design for {{Assistive Technology}}},
  author = {Poulson, D and Ashby, M and Richardson, S},
  date = {1996},
  journaltitle = {Optics express},
  shortjournal = {Opt. Express},
  volume = {19},
