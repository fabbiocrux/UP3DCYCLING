@article{freire-gonzalez2022a,
  title = {Policy Strategies to Tackle Rebound Effects: {{A}} Comparative Analysis},
  shorttitle = {Policy Strategies to Tackle Rebound Effects},
  author = {Freire-Gonz\'alez, Jaume and Ho, Mun S.},
  date = {2022-03-01},
  journaltitle = {Ecological Economics},
  shortjournal = {Ecol. Econ.},
  volume = {193},
  pages = {107332},
  publisher = {Elsevier},
