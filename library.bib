  author = {Delpierre, S\'ebastien and Willocq, Bertrand and Manini, Giuseppe and Lemaur, Vincent and Goole, Jonathan and Gerbaux, Pascal and Cornil, J\'er\^ome and Dubois, Philippe and Raquez, Jean Marie},
