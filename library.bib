@article{bernat2023,
  title = {Post-{{Consumer Plastic Waste Management}}: {{From Collection}} and {{Sortation}} to {{Mechanical Recycling}}},
  shorttitle = {Post-{{Consumer Plastic Waste Management}}},
  author = {Bernat, Katarzyna},
  date = {2023-01},
  journaltitle = {Energies},
  volume = {16},
