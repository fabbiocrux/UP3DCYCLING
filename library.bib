@article{calistofriant2020,
  title = {A Typology of Circular Economy Discourses: {{Navigating}} the Diverse Visions of a Contested Paradigm},
  author = {Calisto Friant, Martin and Vermeulen, Walter J.V. and Salomone, Roberta},
  date = {2020-10-01},
  journaltitle = {Resources, Conservation and Recycling},
