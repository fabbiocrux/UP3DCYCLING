@article{vanegmond2011,
  title = {Sustainability: {{The}} Search for the Integral Worldview},
  author = {family=Egmond, given=N. D., prefix=van, useprefix=true and family=Vries, given=H. J.M., prefix=de, useprefix=true},
  date = {2011-10-01},
