@article{sarancic2023,
  title = {Designing Sustainable Product-Service Systems: {{A}} Generic Process Model for the Early Stages},
  shorttitle = {Designing Sustainable Product-Service Systems},
  author = {Sarancic, David and Pigosso, Daniela C. A. and Pezzotta, Giuditta and Pirola, Fabiana and McAloone, Tim C.},
