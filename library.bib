  abstract = {The price of oil has a great influence on prices of recycled plastics and, therefore, plastic recycling efforts. Here, we analyze the effects of the ongoing COVID-19 pandemic on crude oil price and how this, in turn, is likely to affect the degree of plastic recycling that takes place. Impulse response functions and variance decompositions, calculated from the structural vector autoregression, suggest that changes in crude oil prices are key drivers of the price of recycled plastics. The findings highlight that because plastics are made from the by-products of oil, falling oil prices increase the cost of recycling. Therefore, the price of recycled plastics should be supported using taxes while encouraging sustained behavioral changes among consumers and producers to selectively collect and recycle personal protective equipment so that they do not clog our landfills or end up in our water bodies as plastic waste.},
  file = {/Users/FabioCruz/Zotero/storage/N6B2GFXJ/full-text.pdf}
}

@article{istirokhatun2025,
  title = {Novel Methods for Recycling {{PET}} Plastic Bottle Waste: {{Progressing}} Membrane Engineering Using Environmentally Friendly Solutions},
  shorttitle = {Novel Methods for Recycling {{PET}} Plastic Bottle Waste},
  author = {Istirokhatun, Titik and Siahaan, Samuel Ezra and Susanto, Heru and Gonzales, Ralph Rolly and Filardli, Abdullah Malik Islam and Andarani, Pertiwi and Matsuyama, Hideto},
  date = {2025-11-15},
  journaltitle = {Journal of Cleaner Production},
  shortjournal = {J. Clean. Prod.},
  volume = {532},
  pages = {146967},
  issn = {0959-6526},
  doi = {10.1016/j.jclepro.2025.146967},
  url = {https://www.sciencedirect.com/science/article/pii/S0959652625023248},
  urldate = {2025-11-19},
  abstract = {The growing environmental concerns surrounding plastic waste, particularly polyethylene terephthalate (PET) plastic bottles, have heightened the need for innovative recycling methods. This review examines the potential of recycling PET waste for membrane fabrication as a sustainable solution for various industrial applications. It begins with an overview of PET's composition, properties, and environmental impact, followed by a discussion of current PET recycling methods, their advantages, and associated challenges. The focus then shifts to the conversion of PET waste into membrane materials through techniques such as blending, chemical modification, and electrospinning. The physical, chemical, and mechanical properties of PET-based membranes are analyzed to assess their suitability for applications in water treatment, gas separation, and biomedicine. This review adopts the frameworks of Circular Economy, Resource-Based View, and Eco-Efficiency to explain how PET waste recycling in membrane engineering supports sustainability and economic viability. Additionally, the benefits of using recycled PET, including cost-effectiveness and environmental sustainability, are weighed against the technical and economic challenges in membrane fabrication. Innovations in PET membrane technology, sustainable processing approaches, and the need for further research and development are explored, emphasizing the role of PET recycling in advancing membrane technology and addressing global environmental issues. Furthermore, the integration of mechanical and chemical recycling processes has significantly improved PET waste management, enhanced efficiency and sustainability while supporting circular economy initiatives. By highlighting recent advancements in PET-based membranes, this review underscores the importance of developing more effective recycling strategies to mitigate plastic pollution and promote greener industrial practices.},
  file = {/Users/FabioCruz/Zotero/storage/KAQXCCVD/S0959652625023248.html}
}

