@article{nichols2017,
  title = {Unifying {{Space}} and {{Service}} for {{Makers}}, {{Entrepreneurs}}, and {{Digital Scholars}}},
  author = {Nichols, Jennifer and Melo, Marijel Maggie and Dewland, Jason},
  date = {2017},
  journaltitle = {portal: Libraries and the Academy},
  shortjournal = {Portal Libr. Acad.},
  volume = {17},
