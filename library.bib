  url = {https://www.sciencedirect.com/science/article/pii/S095965261730639X},
  urldate = {2025-04-10},
  abstract = {Universities have responsibilities for accelerating pedagogical innovation to enable a more sustainable future. This research work develops a three-phased approach for integrating principles of a circular economy system within a course in energy policy. The phases involve scanning available resources, identifying possible matches based on the quality of energy, namely exergy, and determining solution areas. The case study is a university-founded dairy facility in the province of Ankara, Turkey with a biogas production potential of 982~m3 per day. Four scenarios are analyzed based on options for combined heat and power, organic Rankine cycle, waste heat recovery, absorption chillers, ground source heat pumps, photovoltaic thermal arrays, and/or low-speed wind turbines. In total, 184.1~kWe of high exergy power and 285.3 kWt of low exergy thermal power may be produced. Further evaluation of the scenarios indicates that the level of exergy match may reach 0.87 while primary energy and primary exergy savings over separate energy production from renewables may be 38\% and 61\%, respectively. The solution areas can address aspects of an energy, water, and food nexus based on energy from waste, energy for irrigation and agriculture, and other linkages. The results are used to engage students in advancing the Sustainable Energy Action Plans of local municipalities. The approach has applicability to other cases in a time when pedagogical innovation is urgently needed to stimulate environmental sustainability.},
  file = {/Users/FabioCruz/Zotero/storage/IQBLBRQD/Kılkış y Kılkış - 2017 - Integrated circular economy and education model to address aspects of an energy-water-food nexus in.pdf;/Users/FabioCruz/Zotero/storage/8ZVUTZK6/S095965261730639X.html}
}

@article{kim2015,
