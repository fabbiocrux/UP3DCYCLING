@article{keeler2026,
  title = {Different Methods, Different Values: {{Policy}} Implications of Alternative Valuation Methods},
  shorttitle = {Different Methods, Different Values},
  author = {Keeler, Bonnie and Clement, Joshua and Mayer, Terin and Noe, Ryan and Vikeras, Nate},
  date = {2026-01-01},
  journaltitle = {Ecological Economics},
  shortjournal = {Ecol. Econ.},
