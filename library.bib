@article{marche2022,
  title = {Qualitative Sustainability Assessment of Road Verge Management in {{France}}: {{An}} Approach from Causal Diagrams to Seize the Importance of Impact Pathways},
  shorttitle = {Qualitative Sustainability Assessment of Road Verge Management in {{France}}},
  author = {Marche, Brunelle and Camargo, Mauricio and Bautista Rodriguez, Sandra Cecilia and Chaudron, Cl\'emence and Mayer, Fr\'ed\'erique and Bachmann, Christophe},
  date = {2022-11},
  journaltitle = {Environmental Impact Assessment Review},
