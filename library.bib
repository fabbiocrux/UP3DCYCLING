@article{borms2023,
  title = {The Working Future: {{An}} Analysis of Skills Needed by Circular Startups},
  shorttitle = {The Working Future},
  author = {Borms, Lize and Van Opstal, Wim and Brusselaers, Jan and Van Passel, Steven},
  date = {2023-07-10},
  journaltitle = {Journal of Cleaner Production},
  shortjournal = {J. Clean. Prod.},
