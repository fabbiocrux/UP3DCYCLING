@article{baumers2011,
  title = {Sustainability of Additive Manufacturing: Measuring the Energy Consumption of the Laser Sintering Process},
  author = {Baumers, M. and Tuck, C. and Bourell, D. L. and Sreenivasan, R. and Hague, R.},
