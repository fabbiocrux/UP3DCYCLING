@article{kish2021,
  title = {Fostering Critical Pluralism with Systems Theory, Methods, and Heuristics},
  author = {Kish, K. and Mallery, D. and Yahya Haage, G. and Melgar-Melgar, R. and Burke, M. and Orr, C. and Smolyar, N. L. and Sanniti, S. and Larson, J.},
  date = {2021-11-01},
