  pages = {1--25},
  publisher = {RSA Website},
  issn = {2158-2041},
  doi = {10.1080/21582041.2025.2585103},
  url = {https://doi.org/10.1080/21582041.2025.2585103},
  urldate = {2025-12-07},
  abstract = {This article traces the conceptual and political trajectory of tiers-lieux (third places) in France, analysing how a term rooted in Ray Oldenburg's sociological notion of informal gathering spaces has been reinterpreted as a flexible, citizen-driven response to social, cultural, and economic transformations. The first part examines how the meaning of third place has evolved in French discourse---from spaces of conviviality and experimentation to diverse configurations such as commons-based, cultural, productive, or solidarity-oriented infrastructures---reflecting shifting understandings of work, citizenship, and local development. The second part investigates how public actors, at both national and regional levels, have contributed to institutionalising and framing this concept through discourse, funding mechanisms, and categorisation efforts. Drawing on political sociology and public action theories, a review of policy and academic sources, field observations, and over 100 interviews (2018--2025), the article analyses how state instruments---calls for projects, labels, observatories, and training schemes---govern ``at a distance'' while fostering collaborative governance. It argues that third places embody a new form of mission-oriented public action: co-produced between state and civic actors, balancing institutional recognition with local autonomy. Ultimately, the article calls for preserving their experimental and plural nature as infrastructures of democratic renewal and territorial innovation.},
  file = {/Users/FabioCruz/Zotero/storage/S57G9ACD/Gauthier y Magkou - 2025 - Understanding ‘tiers-lieux’ framing and policy support of third places in France.pdf}
}

