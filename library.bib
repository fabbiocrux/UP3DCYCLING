@article{bordoni2023,
  title = {Assessment of Natural Capital and Environmental Flows Distribution: {{A Mediterranean}} Case Study},
  shorttitle = {Assessment of Natural Capital and Environmental Flows Distribution},
  author = {Bordoni, Rachele and Rigo, Ilaria and Dapueto, Giulia and Povero, Paolo and Vassallo, Paolo and Paoli, Chiara},
  date = {2023-07-10},
  journaltitle = {Journal of Cleaner Production},
  shortjournal = {J. Clean. Prod.},
  volume = {409},
  pages = {137228},
  issn = {0959-6526},
  doi = {10.1016/j.jclepro.2023.137228},
  url = {https://www.sciencedirect.com/science/article/pii/S0959652623013860},
  urldate = {2023-05-01},
  abstract = {The coastal marine area hosts among the most productive ecosystems in the world, in terms of biomass and species richness. These ecosystems' natural capital stocks provide essential flows of resources for the environment and human life. The distribution of natural capital (NC) and environmental flows (ENFL) characterizing the coastal marine habitats of Ligurian Sea, a biodiversity hotspot in the Mediterranean region, were assessed to define their current state. The study area was divided into 43 functional spatial sections, defined as ``biomarine units''. In each biomarine unit natural capital and environmental flows were estimated using data on benthic and fish biomass. Emergy analysis, a thermodynamics-based methodology that expresses the costs in terms of resources incurred by nature to maintain the ecological processes of the marine coastal habitats, was then applied to assess the natural capital and the environmental flows in biophysical terms (solar emergy joules, sej), and using appropriate conversion factors, in monetary terms (emergy euro, em\texteuro ). The monetary equivalents facilitate understanding for stakeholders and pave the way for the inclusion of marine resources value in socioeconomic and political contexts. The total value of natural capital for the Ligurian coastal and marine area is 2.11 billion em\texteuro, while for environmental flows, it is 1.43 billion em\texteuro{} a-1. Greater values belong to units included within the boundaries of protected areas, proving the efficiency of the protection measures taken. These values represent a reference point and shall be kept constant to preserve natural capital and to ensure services provisioning at least at the current level. This work identify a method useful to monitor the status of natural capital value and environmental flows along Ligurian coast, which can be helpful to stakeholders and policymakers for better monitoring and management of the area.},
  langid = {english},
  file = {/Users/FabioCruz/Zotero/storage/E9TXD94A/Bordoni et al_2023_Assessment of natural capital and environmental flows distribution.pdf;/Users/FabioCruz/Zotero/storage/RSBRVVRL/S0959652623013860.html}
}

@article{boretti2026,
  title = {A Sustainability Index for Guiding Polymer Design in a Circular Economy},
  author = {Boretti, Alberto},
  date = {2026-09-05},
  journaltitle = {Journal of Cleaner Production},
  shortjournal = {J. Clean. Prod.},
  volume = {575},
  pages = {149212},
  issn = {0959-6526},
  doi = {10.1016/j.jclepro.2026.149212},
  url = {https://www.sciencedirect.com/science/article/pii/S0959652626017531},
  urldate = {2026-09-13},
  abstract = {The global shift toward a circular plastics economy is driving innovation in polymer science. This narrative review synthesizes recent literature on four interconnected pillars: chemically recyclable polymers (dynamic covalent networks, low-ceiling-temperature monomers); biopolymers from renewable feedstocks; advanced upcycling of plastic waste; and engineered biodegradability. We frame these within circular economy principles, assessing sustainability as a multidimensional concept encompassing feedstock origin, performance, end-of-life fate, and economic viability. Molecular innovations enable closed-loop cycles without compromising performance, while computational tools and green chemistry accelerate development. Building on this synthesis, we propose the Polymer Circularity-Sustainability Index (PCSI)---a composite metric integrating recyclability, bio-based content, upcycling potential, biodegradability, and enabler integration. The PCSI is presented as a framework for discussion and refinement rather than a definitive assessment tool; all parameters, thresholds, and weighting schemes are provisional and require empirical validation through comparison with lifecycle assessment results. The mathematical formulation employs logistic normalization functions to avoid arbitrary linear scaling, explicitly acknowledges key limitations of each component, and provides a roadmap for empirical validation spanning parameter refinement, LCA comparison, expert elicitation, and standardization. The index is designed as a screening tool to guide, not replace, comprehensive lifecycle assessment, and its component weights should be adjusted based on specific application contexts and regional infrastructure availability. Any quantitative framework must be interpreted with attention to context (application requirements, infrastructure, waste management). We conclude with a forward-looking perspective on the interdisciplinary convergence---policy, scalable manufacturing, lifecycle thinking---needed for a truly circular polymer economy.},
  file = {/Users/FabioCruz/Zotero/storage/FSSTJ9IF/Boretti - 2026 - A sustainability index for guiding polymer design in a circular economy.pdf;/Users/FabioCruz/Zotero/storage/2A7YU66P/S0959652626017531.html}
}

