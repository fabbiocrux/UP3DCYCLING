@article{dominguezlacasa2025,
  title = {Embracing the Third Mission through Art: {{Pathways}} to Address Climate Change},
  shorttitle = {Embracing the Third Mission through Art},
  author = {Dominguez Lacasa, Iciar and Mietzner, Dana},
