@article{naughtin2024,
  title = {Forty Years in the Making: {{A}} Systematic Review of the Megatrends Literature},
  shorttitle = {Forty Years in the Making},
  author = {Naughtin, Claire K. and Schleiger, Emma and Bratanova, Alexandra and Terhorst, Andrew and Hajkowicz, Stefan},
  date = {2024-03-01},
  journaltitle = {Futures},
  volume = {157},
  pages = {103329},
  issn = {0016-3287},
  doi = {10.1016/j.futures.2024.103329},
  url = {https://www.sciencedirect.com/science/article/pii/S0016328724000120},
  urldate = {2024-02-29},
  abstract = {Four decades ago, the concept of megatrends was introduced by John Naisbitt (1929--2021). The popular tool has since been adopted by researchers, consultants, private enterprises and governments to explore long-term futures across a diverse range of regions, industries and socioeconomic domains. The widespread use of megatrends has led to variability in how the concept is applied and a lack of scientific rigour around the approach, and previous attempts to synthesise the megatrends literature have been incomplete. The current paper presents the first systematic review of megatrends publications from 1982 to 2022, including a bibliometric analysis of publishing trends. We provide a consensus view of how the concept has been defined and applied in academic and non-academic literature and propose a standardised process for improving the scientific rigour of megatrend analyses. From an analysis of 267 studies, we present a novel diagnostic tool for defining megatrends that brings together the consensus characteristics of megatrends (e.g., its multidisciplinary nature, drivers of change, breadth, long time span and forward-focused lens). Our findings also reveal validity and reliability issues associated with megatrend studies, and from this, we present a standardised approach for developing and validating megatrends that improves upon these shortcomings.},
  file = {/Users/FabioCruz/Zotero/storage/MQP8MZKG/S0016328724000120.html}
}

