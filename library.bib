@article{pronost2024,
  title = {Digital {{Twins}} along the Product Lifecycle: {{A}} Systematic Literature Review of Applications in Manufacturing},
  shorttitle = {Digital {{Twins}} along the Product Lifecycle},
  author = {Pronost, Guillaume and Mayer, Fr\'ed\'erique and Camargo, Mauricio and Dupont, Laurent},
  date = {2024-12-31},
