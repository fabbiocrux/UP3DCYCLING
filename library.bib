  urldate = {2025-11-19},
  abstract = {This study addresses the sustainability and resilience challenges within the plastic value chain (PVC) by developing a comprehensive multi-objective mixed-integer programming (MOMIP) optimization model. The model integrates the principles of the circular economy, focusing on minimizing costs, reducing environmental impacts, and maximizing customer responsiveness. To effectively manage the uncertainties inherent in supply chain operations, the model employs a robust optimization framework. A novel Multi-Objective Adaptive Variable Neighborhood Search (MO-AVNS) heuristic approach is introduced to improve the exploration of the solution space and ensure robust performance under uncertain conditions. Additionally, an enhanced augmented {$\varepsilon$}-constraint method is developed to balance the multi-objective optimization challenges. The proposed model and heuristic approach are validated through rigorous numerical experiments and a real-world case study in Iran, demonstrating their effectiveness in promoting sustainable and resilient practices in the PVC supply chain. The results indicate that the proposed MOMIP model achieved an 18~\% reduction in total costs, a 20~\% decrease in CO2 emissions, and a 15~\% improvement in customer responsiveness compared to traditional methods. The study demonstrates that integrating robust optimization and heuristic approaches significantly enhances the sustainability and resilience of the plastic value chain, making it an effective tool for real-world supply chain management.},
  file = {/Users/FabioCruz/Zotero/storage/HADGH2PI/S0959652625022899.html}
}

