  author = {Rocha, Juan C. and Schill, Caroline and Lindkvist, Emilie A.L. and Biggs, Reinette and Blenckner, Thorsten and Cr\'epin, Anne-Sophie and Fetzer, Ingo and Folke, Carl and Jim\'enez-Aceituno, Amanda and Knecht, Nielja and Kuiper, Jan J. and Lade, Steven J. and Lanyon-Garrido, Carla and Lotcheris, Romi and Martin, Romina and Masterson, Vanessa and Matous, Petr and Moore, Michele-Lee and Nystr\"om, Magnus and Olsson, Per and Pereira, Laura M. and Peterson, Garry and family=Silva, given=Andr\'e Pinto, prefix=da, useprefix=true and Quahe, Sasha and Schl\"uter, Maja and Svedin, Uno and Wang-Erlandsson, Lan and Zoller, Hannah},
