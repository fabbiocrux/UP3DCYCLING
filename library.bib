}

@article{petersen2017a,
  title = {Impact of {{DIY Home Manufacturing}} with {{3D Printing}} on the {{Toy}} and {{Game Market}}},
  author = {Petersen, Emily and Kidd, Romain and Pearce, Joshua},
  date = {2017},
  journaltitle = {Technologies},
