@article{maione2022,
  title = {Towards a Circular Economy for the Plastic Packaging Sector: {{Insights}} from the {{Italian}} Case},
  shorttitle = {Towards a Circular Economy for the Plastic Packaging Sector},
  author = {Maione, Carol and Lapko, Yulia and Trucco, Paolo},
  date = {2022-11-01},
