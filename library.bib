@article{ramli2024,
  title = {Advancing Circular Economy Approaches in Plastic Waste Management: {{A}} Systematic Literature Review in Developing Economies},
  shorttitle = {Advancing Circular Economy Approaches in Plastic Waste Management},
  author = {Ramli, Abu Hanifah Mohammad and Manaf, Latifah Abd. and Zulkefli, Zufarzaana and Andriyono, Sapto},
  date = {2024-08-22},
  journaltitle = {Sustainable Production and Consumption},
