@article{saidi2017,
  title = {The Sociology of Space as a Catalyst for Innovation in the Health Sector},
  author = {Saidi, Trust and family=Villiers, given=Katusha, prefix=de, useprefix=true and Douglas, Tania S.},
  date = {2017},
  journaltitle = {Social Science and Medicine},
  shortjournal = {Soc. Sci. Med.},
