@article{toivonen2021,
  title = {Empowering Upcoming City Developers with Futures Literacy},
  author = {Toivonen, Saija and Rashidfarokhi, Anahita and Kyr\"o, Riikka},
  date = {2021-05-01},
  journaltitle = {Futures},
  volume = {129},
  pages = {102734},
