@article{esashika2020,
  title = {An Investigation into the Elusive Concept of Smart Cities: A Systematic Review and Meta-Synthesis},
  author = {Esashika, Daniel and Masiero, Gilmar and Mauger, Yohann},
  date = {2020-12-07},
  journaltitle = {Technology Analysis \& Strategic Management},
  shortjournal = {Technol. Anal. Strateg. Manag.},
