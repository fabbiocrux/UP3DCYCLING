@article{torresjunior2025,
  title = {Orchestrating Innovation Networks Motivated by Wicked Problems: A Theoretical Systematization Proposal},
  shorttitle = {Orchestrating Innovation Networks Motivated by Wicked Problems},
  author = {Torres Junior, Paulo and family=Alencar, given=Rafaela Cajado Magalh\~aes, prefix=de, useprefix=false and C\^amara, Samuel Fa\c canha and J\'unior, Elias Pereira Lopes},
  date = {2025-12-11},
  journaltitle = {Technology Analysis \& Strategic Management},
  shortjournal = {Technol. Anal. Strateg. Manag.},
  volume = {0},
  number = {0},
  pages = {1--18},
  publisher = {Routledge},
  issn = {0953-7325},
  doi = {10.1080/09537325.2025.2599444},
  url = {https://doi.org/10.1080/09537325.2025.2599444},
  urldate = {2026-01-12},
  abstract = {This study proposes a novel framework for orchestrating innovation networks in response to wicked problems, such as crises and urgent social demands. Building upon recent calls to examine how innovation emerges in volatile and uncertain environments, the framework integrates relational and structural dimensions of orchestration -- including trust, engagement, distributed leadership, and orchestration readiness. Drawing from the evolution of orchestration literature and engaging critically with recent contributions, the study reconceptualizes orchestration as a dynamic, problem-oriented capability rather than a static managerial function. To empirically validate the framework's applicability beyond conceptual boundaries, we incorporate international cases such as the UK's VentilatorChallengeUK consortium, the global COVAX initiative, and emergency telemedicine networks in Italy. These examples illustrate how adaptive coordination, cross-sector trust-building, and emergent leadership are essential in enabling rapid and collective responses to complex societal challenges. Our contribution is threefold: (i) theoretical, by advancing orchestration as a meta-capability in hybrid and mission-oriented networks; (ii) managerial, by offering actionable guidance for public and private actors during crises; and (iii) social, by highlighting how orchestrated innovation can produce immediate public value under extreme conditions. While grounded in robust theory, future research should enhance empirical testing through comparative case studies across diverse innovation ecosystems.}
}

