@article{chong2017,
  title = {Physical {{Characterization}} and {{Pre-assessment}} of {{Recycled High-Density Polyethylene}} as {{3D Printing Material}}},
  author = {Chong, Siewhui and Pan, Guan-Ting and Khalid, Mohammad and Yang, Thomas C.K. and Hung, Shuo-Ting and Huang, Chao-Ming},
