@article{bonvoisin2021,
  title = {Seven Observations and Research Questions about {{Open Design}} and {{Open Source Hardware}}},
  author = {Bonvoisin, J\'er\'emy and Mies, Robert and Boujut, Jean-Fran\c cois},
