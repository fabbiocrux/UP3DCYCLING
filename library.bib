  url = {https://www.sciencedirect.com/science/article/pii/S0959652623038258},
  urldate = {2023-12-18},
  abstract = {The escalating global population and subsequent societal demands have contributed to a notable upsurge in production activities, resulting in unprecedented anthropogenic disturbances to the Earth's environment. The intensifying tense relationship between humans and nature has become a crucial obstacle that hampers the normal progress of human production and livelihood. In order to embrace a cleaner planet and achieve sustainable development of human society, investigating the process of human-nature interaction has remained a prominent research focus. However, most studies primarily analyze environmental issues within isolated domains, leading to the accumulation of fragmented insights that may cause a chaotic and non-systematic environmental consciousness. This work comprehensively investigates the feedback effects arising from human-nature interactions from a holistic and integrated Earth perspective while also exploring positive actions aimed at fostering harmonious coexistence between humans and nature. Firstly, the theory of a feedback loop in the interaction between humans and nature is proposed. Subsequently, anthropogenic impacts on the Earth's five major spheres are successively analyzed, along with representative phenomena that have resulted in retribution upon humankind. These efforts lay the foundation for the integrated feedback loop model, which comprehensively reveals the causal linkages between human activities and their environmental consequences. Furthermore, the issue of time scales regarding human vulnerability and self-reflection is discussed. Finally, action guidelines are provided at three distinct social levels, calling upon all human stakeholders to actively engage in more concerted actions for an effective response to the environmental crisis to build a cleaner and more comfortable planet.},
  file = {/Users/FabioCruz/Zotero/storage/TGEIDUYG/S0959652623038258.html}
}

