@article{gabriel2023,
  title = {Open Source {{IoT-based}} Collection Bin Applied to Local Plastic Recycling},
  author = {Gabriel, Alex and Cruz, Fabio},
  date = {2023-03-01},
  journaltitle = {HardwareX},
  volume = {13},
  pages = {e00389},
