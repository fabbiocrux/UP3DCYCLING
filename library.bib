@article{zhong2018,
  title = {Tightening the Loop on the Circular Economy: {{Coupled}} Distributed Recycling and Manufacturing with Recyclebot and {{RepRap}} 3-{{D}} Printing},
  author = {Zhong, Shan and Pearce, Joshua M.},
  date = {2018-01},
  journaltitle = {Resources, Conservation and Recycling},
  shortjournal = {Resour. Conserv. Recycl.},
  volume = {128},
  pages = {48--58},
  publisher = {Elsevier},
