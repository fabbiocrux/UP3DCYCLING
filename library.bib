}

@article{liu2024a,
  title = {Low-{{Cost Open-Source Melt Flow Index System}} for {{Distributed Recycling}} and {{Additive Manufacturing}}},
  author = {Liu, Dawei and Basdeo, Aditi and Gonzalez, Catalina Suescun and Romani, Alessia and Boudaoud, Hakim and Nouvel, C\'ecile and Cruz Sanchez, Fabio A. and Pearce, Joshua M.},
