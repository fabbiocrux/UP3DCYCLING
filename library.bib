@article{lange2022,
  title = {Progress on Ecosystem Accounting in {{Europe}}},
  author = {Lange, Sabine and Campagne, Carole Sylvie and Comte, Adrien and Bank, Emily and Santos-Mart\'in, Fernando and Maes, Joachim and Burkhard, Benjamin},
  date = {2022-10-01},
  journaltitle = {Ecosystem Services},
