  issn = {0959-6526},
  doi = {10.1016/J.JCLEPRO.2022.130874},
  abstract = {This paper focuses on a comparative study of the governance of Circular Economy (CE) in sixteen different countries. The analysis rests on a theoretical framework of insights gained in transition management literature and public administration, particularly network governance. It is assumed that two forms of governance are needed to cope with the complex circular economy transition process: public and network governance. The hypothesis was that in order to implement CE effectively, strong leadership of government, active involvement of stakeholders and receptivity to network governance are crucial. Based on the analysis described in this paper, two models have been designed that refine the original hypothesis: a model on the effectiveness of CE governance and a model that presents four main avenues for developing CE in different socio-cultural and political contexts. It is recommended to continue exploring this area of research, which is underexamined in the literature.},
  file = {/Users/FabioCruz/Zotero/storage/W68T2RUE/full-text.pdf}
}

