@article{gonella2023,
  title = {Towards a Regenerative Economy: {{An}} Innovative Scale to Measure People's Awareness of the Circular Economy},
  shorttitle = {Towards a Regenerative Economy},
  author = {Gonella, J\'essica dos Santos Leite and Godinho Filho, Moacir and Ganga, Gilberto Miller Dev\'os and Latan, Hengky and Chiappetta Jabbour, Charbel Jose},
