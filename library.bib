@inproceedings{rudele2024,
  title = {Circular {{Economy}} in {{Learning Factories Using}} the {{Example}} of {{Transfer Molding}}},
  booktitle = {Learning {{Factories}} of the {{Future}}},
  author = {R\"udele, Kai and Stre\ss ler, Thomas and Ramsauer, Christian},
  editor = {Thiede, Sebastian and Lutters, Eric},
