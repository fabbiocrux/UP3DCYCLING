  title = {{{ANALYZING THE PAST TO PREPARE FOR THE FUTURE}}: {{WRITING A LITERATURE REVIEW}}},
  author = {Pignatelli, Pasquale and Sanguigni, Valerio and Paola, Sciacca Giordano and Lo Coco, Emanuela and Lenti, Luisa and Violi, Francesco},
