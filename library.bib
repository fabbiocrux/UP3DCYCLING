@article{vanhoof2025,
  title = {Circular Economy Policy Resilience and Robustness in {{Latin America}} and the {{Caribbean}}},
  author = {family=Hoof, given=Bart, prefix=van, useprefix=true and Aguilar-Hernandez, Glenn A.},
  date = {2025-10-25},
  journaltitle = {Journal of Cleaner Production},
  shortjournal = {J. Clean. Prod.},
  volume = {529},
  pages = {146755},
  issn = {0959-6526},
  doi = {10.1016/j.jclepro.2025.146755},
  url = {https://www.sciencedirect.com/science/article/pii/S0959652625021055},
  urldate = {2025-11-19},
  abstract = {Latin America and the Caribbean (LAC) has made significant progress in advancing the Circular Economy (CE) agenda at national levels. Since 2019, eleven LAC countries have proposed National Circular Economy Strategies (NCES) and CE Roadmaps. National Strategies and roadmaps set priorities and propose governance structures and instruments for advancing the CE transition. However, the durable impact of CE policies over time is uncertain due to short-term governance cycles, as the region is marked by challenges in political stability and government changes. While societal transformation towards a CE is expected to take decades, the imbalance between governmental changes and CE policy priority setting emphasizes the need for systems that enhance long-term CE policy resilience and robustness in LAC. This paper identifies factors for enhancing the resilience and robustness of long-term CE policies in the region by applying transition management principles and network governance models. A focus group was developed with CE official representatives involved in the CE policy development in 8 LAC countries---Chile, Colombia, Costa Rica, Dominican Republic, Ecuador, Paraguay, Peru, and Uruguay---and identified in a co-creating process the main challenges and factors to ensure durable impact of CE policies across government transitions in the region. The focus group outcomes were linked to the Worldwide Governance Indicators to assess the political stability of the analyzed countries, providing insights into the CE policy resilience and robustness factors of LAC countries. The outcomes echo practices recommended by transition theory and network governance models, and the adoption of legal backup by higher order laws supporting as instruments for the resilience and robustness of long-term CE policy making.},
  file = {/Users/FabioCruz/Zotero/storage/YSTTP4LU/van Hoof y Aguilar-Hernandez - 2025 - Circular economy policy resilience and robustness in Latin America and the Caribbean.pdf;/Users/FabioCruz/Zotero/storage/Q2NHE6UV/S0959652625021055.html}
}

@article{vanhulst2026,
  title = {Conceptualizing Transdisciplinarity: {{How}} Do Visuals Mean?},
  shorttitle = {Conceptualizing Transdisciplinarity},
  author = {family=Hulst, given=Merlijn, prefix=van, useprefix=true and Holstead, Kirsty and Metze, Tamara},
  date = {2026-01-07},
  journaltitle = {Environmental Science \& Policy},
  shortjournal = {Environ. Sci. Policy},
  pages = {104253},
  issn = {1462-9011},
  doi = {10.1016/j.envsci.2025.104253},
  url = {https://www.sciencedirect.com/science/article/pii/S1462901125002692},
  urldate = {2026-01-12},
  abstract = {Transdisciplinary research is commonly understood as a research collaboration between different academic disciplines and actors from different sectors of society to co-produce knowledge needed in addressing real-world problems. In this paper, we understand transdisciplinary research as an epistemological object and study how researchers conceptualize it through visualization. To do this, we analyzed a set of related visuals in their textual context published over the last 20 years. This multi-modal analysis shows that transdisciplinarity in our set has, throughout the years, consisted of three main categories: science, practice, and the transdisciplinary research process. Transdisciplinary research has been visualized as a stable double-joint cyclical narrative starting in the settings of science and practice, after which actors join to collaborate, both depart with the results of collaboration. An assumed principle is continuously and implicitly visualized: the idea and ideal that science and practice are contributing, collaborating, and reaping benefits on the basis of equality. Supported by the literature, we problematize this way visuals obscure imbalances in practice. Finally, we discuss how visuals mean and what other ways of conceptualizing an epistemic object like transdisciplinary are possible.},
  file = {/Users/FabioCruz/Zotero/storage/Q2H8NEHQ/van Hulst et al. - 2026 - Conceptualizing transdisciplinarity How do visuals mean.pdf;/Users/FabioCruz/Zotero/storage/5XFQESIJ/S1462901125002692.html}
}

