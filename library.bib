  url = {https://www.sciencedirect.com/science/article/pii/S092134492600248X},
  urldate = {2026-06-17},
  abstract = {Electro- and photocatalytic C-X bond (where X = N or S) coupling from waste plastics represents an emerging upgrading strategy, enabling the conversion of waste carbon resources into high-value chemicals and thereby facilitating carbon circularity. However, this process faces multiple challenges, including complex reaction networks, competing side reactions, and unstable catalytic active sites, which significantly limit the activity, selectivity, and long-term stability during the C-X coupling reaction. To enhance reaction efficiency and durability, a fundamental understanding of catalytic mechanisms and the rational design of active sites are essential to achieve efficient activation of plastic monomers and balanced adsorption-desorption of key intermediates. This review systematically summarizes the progress in electro- and photocatalytic C-X coupling for waste plastic upgrading by focusing on catalyst design, control of reactive intermediates, and mechanistic elucidation. Furthermore, the economic feasibility and environmental benefits of these plastic upgrading strategies are evaluated through techno-economic analysis and life-cycle assessment. Finally, current challenges in the field are outlined, and future research directions are also proposed. This review aims to provide theoretical insights and inspire further research toward developing higher-value products from plastic waste.},
  file = {/Users/FabioCruz/Zotero/storage/E3VZIBC3/S092134492600248X.html}
}

