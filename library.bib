@article{sanchez-soto2008,
  title = {Blends of {{HDPE}} Wastes: {{Study}} of the Properties},
  author = {S\'anchez-Soto, M. and Rossa, A. and S\'anchez, A. J. and G\'amez-P\'erez, J.},
  date = {2008},
  journaltitle = {Waste Management},
