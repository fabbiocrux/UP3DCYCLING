  urldate = {2026-06-17},
  abstract = {Recycled high-density polyethene (rHDPE) contains volatile and semi-volatile organic compounds that restrict high-value applications and degrade mechanical, thermal, and rheological performance during reprocessing. This study proposes a grafting approach in which rHDPE is functionalized with diurethane dimethacrylate (DUDMA) and subsequently modified with maleic anhydride (MAH) through reactive extrusion to enhance polarity, chain architecture, and material functionality. FTIR and Raman spectroscopy confirmed graft formation through intensified ester and C--O bands, while DSC and TGA indicated improved crystallisation behaviour, broader melting transitions, and enhanced thermal stability linked to branched structures. Mechanical performance improved markedly, with tensile strength increasing by up to 18\% and flexural strength by {$>$}60\%. A cradle-to-gate, single-scenario life cycle assessment of industrial bucket production identified injection moulding and extrusion electricity as dominant environmental hotspots. The results indicate that additional inputs associated with material modification contribute marginally to total impacts, suggesting environmental feasibility without disproportionate burdens.},
  file = {/Users/FabioCruz/Zotero/storage/DNNGXC2M/S0921344926002594.html}
}

