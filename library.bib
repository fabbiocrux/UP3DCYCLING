@article{kim2023,
  title = {Augment the {{SDG}} Indicator Framework},
  author = {Kim, Rakhyun E.},
  date = {2023-04-01},
  journaltitle = {Environmental Science \& Policy},
  shortjournal = {Environ. Sci. Policy},
  volume = {142},
