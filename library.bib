@article{arsova2022,
  title = {Implementing Circular Economy in a Regional Context: {{A}} Systematic Literature Review and a Research Agenda},
  shorttitle = {Implementing Circular Economy in a Regional Context},
  author = {Arsova, Sanja and Genovese, Andrea and Ketikidis, Panayiotis H.},
  date = {2022-09-25},
