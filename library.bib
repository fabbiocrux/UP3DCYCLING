@article{dudka2025,
  title = {Evaluating Mineral Resource Boundaries for Application in Absolute Environmental Sustainability Assessment},
  author = {Dudka, Katarzyna Maria and Hauschild, Michael Zwicky and Owsianiak, Miko\l aj},
  date = {2025-06-01},
  journaltitle = {Resources, Conservation and Recycling},
