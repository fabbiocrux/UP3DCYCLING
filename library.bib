@article{burgospintos2024,
  title = {Large Format Additive Manufacturing of Polyethylene Terephthalate ({{PET}}) by Material Extrusion},
  author = {Burgos Pintos, Pedro and Sanz de Le\'on, Alberto and Molina, Sergio I.},
