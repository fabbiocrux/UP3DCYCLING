@article{barford2021,
  title = {A {{Call}} for a {{Socially Restorative Circular Economy}}: {{Waste Pickers}} in the {{Recycled Plastics Supply Chain}}},
  shorttitle = {A {{Call}} for a {{Socially Restorative Circular Economy}}},
  author = {Barford, Anna and Ahmad, Saffy Rose},
  date = {2021-09},
  journaltitle = {Circular Economy and Sustainability},
  shortjournal = {Circ. Econ. Sustain.},
  volume = {1},
  number = {2},
  pages = {761--782},
  issn = {2730-597X, 2730-5988},
  doi = {10.1007/s43615-021-00056-7},
  url = {https://link.springer.com/10.1007/s43615-021-00056-7},
  urldate = {2025-08-01},
  abstract = {Abstract             The labour-intensive task of waste collection for recycling is critical to contemporary forms of corporate circularity. In low- and middle-income countries, waste pickers underpin the recycling loop of the circular economy. Where informality and working poverty are the norm, waste pickers typically receive little social protection, work in dangerous conditions, and earn low wages. Nevertheless, waste pickers' work addresses multiscalar environmental problems from localised flooding of plastic-clogged waterways, to preventing the release of greenhouse gases when plastic is burnt. Here, we review recent academic and grey literature on waste picking, the social circular economy, and corporate circularity to understand the role and position of waste pickers in the contemporary circular economy. We explain how given the recent outcry against plastic waste, and subsequent corporate commitments to plastic recycling, there has been greater action on material flows than in support of the people who move these flows. Overall, the corporate response remains limited, with a general preference for recycling over redesign and only a fifth of packaging accounted for. Based on this review, we present two models. The first is a hierarchy of plastic recycling showing the foundational role of waste pickers in the recycled plastics supply chain. As plastics move up the hierarchy, their value increases and working conditions improve. We also propose a new model for a socially restorative circular economy which provides fair pay, safe working conditions, social protection, legal rights, voice, respect, services, and education. Some governments, co-operatives, non-governmental organisations, and businesses are already working towards this---and their work offers pathways towards a new standard of fair trade recycled materials. We argue that for true sustainability and the best version of circularity to be achieved, deeply ingrained social challenges must be resolved.},
  langid = {english},
  file = {/Users/FabioCruz/Zotero/storage/KRAB9D69/Barford y Ahmad - 2021 - A Call for a Socially Restorative Circular Economy Waste Pickers in the Recycled Plastics Supply Ch.pdf}
}

@article{barfuss2026,
  title = {Natural Tipping Dynamics as Catalysts of Human Cooperation},
  author = {Barfuss, Wolfram and Donges, Jonathan F. and Bethge, Matthias and Levin, Simon A.},
  date = {2026-10-01},
  journaltitle = {Ecological Economics},
  shortjournal = {Ecol. Econ.},
  volume = {248},
  pages = {109082},
  issn = {0921-8009},
  doi = {10.1016/j.ecolecon.2026.109082},
  url = {https://www.sciencedirect.com/science/article/pii/S0921800926001679},
  urldate = {2026-06-19},
  abstract = {The importance of natural tipping elements and regime shifts is broadly recognized, and their mechanisms, risks, and interactions are increasingly well understood. However, less is known about the interrelation between social processes and regime shift dynamics. In particular, the question of how natural tipping dynamics affect sustainable collective action remains open. Here, we introduce a game-theoretic model of collective action within natural tipping dynamics. Explicit social interactions, such as reciprocity, agreements, or communication, are well-known for promoting cooperation. We exclude these in our model to study the isolated effects the tipping dynamics have on the prospects for sustainable collective action. We find that all three classic social dilemma types (Prisoner's Dilemma, Chicken, Stag-Hunt) plus two Harmony games emerge robustly in our model's parameter space. Thus, it is possible to transform any of these collective-action regimes into any other without explicit social processes. We highlight the flexibility of our modeling approach by analyzing agent heterogeneity, boundedly rational learning dynamics, and multiple empirical tipping elements and regime shifts. Our findings reveal the cooperation-promoting potential of the actors' ecological embeddedness and introduce ecological reciprocity as a mechanism for the emergence of cooperation.},
  file = {/Users/FabioCruz/Zotero/storage/22ZVFH72/S0921800926001679.html}
}

