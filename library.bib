@article{cuellar2018,
  title = {Ten Guidelines for the Design of Non-Assembly Mechanisms: {{The}} Case of {{3D-printed}} Prosthetic Hands},
  author = {Cuellar, Juan Sebastian and Smit, Gerwin and Zadpoor, Amir A. and Breedveld, Paul},
