  author = {Parajuly, Keshav and Green, James and Richter, Jessika and Johnson, Michael and R\"uckschloss, Jana and Peeters, Jef and Kuehr, Ruediger and Fitzpatrick, Colin},
  date = {2023},
  journaltitle = {Journal of Industrial Ecology},
