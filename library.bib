@article{singh2025,
  title = {Deep Learning-Based Plastic Classification Using Spectroscopic Data},
  author = {Singh, Aru Ranjan and Neo, Edward Ren Kai and Lai, Car Man and Hazra, Sumit and Coles, Stuart and Peijs, Ton and Debattista, Kurt},
  date = {2025-11-01},
