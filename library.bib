  shorttitle = {Sustainable Energy and Waste Management},
  author = {family=Silva, given=Elisangela Pacheco, prefix=da, useprefix=true and Fragal, Vanessa Hafemann and Fragal, Eliz\^angela Hafemann and Sequinel, Thiago and Gorup, Luiz Fernando and Silva, Rafael and Muniz, Edvani C.},
