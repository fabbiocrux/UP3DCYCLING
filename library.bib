@article{longato2021,
  title = {Practical Applications of Ecosystem Services in Spatial Planning: {{Lessons}} Learned from a Systematic Literature Review},
  author = {Longato, Davide and Cortinovis, Chiara and Albert, Christian and Geneletti, Davide},
  date = {2021-05-01},
  journaltitle = {Environmental Science \& Policy},
  shortjournal = {Environ. Sci. Policy},
