@article{goyanes2014,
  title = {Fused-Filament {{3D}} Printing ({{3DP}}) for Fabrication of Tablets},
  author = {Goyanes, Alvaro and Buanz, Asma B.M. and Basit, Abdul W. and Gaisford, Simon},
