@article{cruzsanchez2017,
  title = {Polymer Recycling in an Open-Source Additive Manufacturing Context: {{Mechanical}} Issues},
  author = {Cruz Sanchez, Fabio A. and Boudaoud, Hakim and Hoppe, Sandrine and Camargo, Mauricio},
