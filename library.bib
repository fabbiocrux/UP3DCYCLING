@article{sun2015,
  title = {A {{Review}} on {{3D Printing}} for {{Customized Food Fabrication}}},
  author = {Sun, Jie and Peng, Zhuo and Zhou, Weibiao and YHFuh, Jerry and Soon Hong, Geok and Chiu, Annette},
