@article{iqbal2021,
  title = {Blended System Thinking Approach to Strengthen the Education and Training in University-Industry Research Collaboration},
  author = {Iqbal, Abeda Muhammad and Khan, Adnan Shahid and Abdullah, Johari and Kulathuramaiyer, Narayanan and Senin, Aslan Amat},
