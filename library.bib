@article{gibovic2021,
  title = {Incentives for {{Plastic Recycling}}: {{How}} to {{Engage Citizens}} in {{Active Collection}}. {{Empirical Evidence}} from {{Spain}}},
  author = {Gibovic, Denisa and Bikfalvi, Andrea},
  date = {2021-04-26},
