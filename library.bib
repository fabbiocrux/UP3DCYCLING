  doi = {10.1016/j.techfore.2025.124468},
  url = {https://www.sciencedirect.com/science/article/pii/S0040162525004998},
  urldate = {2026-01-12},
  abstract = {Although artificial intelligence (AI) is boosting environmental and socio-economic progress in developed countries, its role in waste reduction, management, and recycling remains limited. Hence, this study explores the role of AI investments in waste management (WGN) and waste mitigation efforts in G7 economies through quarterly data from 2012Q1 to 2022Q4. In doing so, several econometric techniques were applied, which range from diagnostic tests for unit root and multicollinearity issues, while the primary method used was quantile regression due to the nonlinearity of the data. The outcomes show that AI's impact increases from lower to higher quantiles, from Q15th~-~0.001 towards Q75th 0.030. In other words, AI is efficient in areas where WGN is low. However, WGN might increase due to AI, where the waste is already high due to the acceleration of industrial sectors and consumption. Furthermore, industrial productivity has a positive but insignificant impact, while urbanization has a negative and significant impact on WGN across quantiles. Air pollution has asymmetrical effects on WGN in both models. Novel policies that adopt AI technologies and applications and reduce air pollution should acknowledge the rising significance of waste management and circular economic models.},
  file = {/Users/FabioCruz/Zotero/storage/9ZIGW73W/S0040162525004998.html}
}

@article{li2026a,
