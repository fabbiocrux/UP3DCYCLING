  author = {Bressanin, J\'essica Marcon and family=Mesquita Sampaio, given=Isabelle Lobo, prefix=de, useprefix=true and Geraldo, Victor Coelho and Klein, Bruno Colling and Chagas, Mateus Ferreira and Bonomi, Antonio and Filho, Rubens Maciel and Cavalett, Ot\'avio},
