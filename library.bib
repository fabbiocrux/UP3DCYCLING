@article{goncalves2024,
  title = {Material Flow Analysis and Circularity Assessment of Plastic Packaging: {{An}} Application to {{Portugal}}},
  shorttitle = {Material Flow Analysis and Circularity Assessment of Plastic Packaging},
  author = {Gon\c calves, Mariana and Freire, Fausto and Garcia, Rita},
