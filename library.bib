@article{matos2023,
  title = {Comparative Analysis of Micro Level Indicators for Evaluating the Progress towards a Circular Economy},
  author = {Matos, Joana and Martins, Carla and Sim\~oes, Carla L. and Simoes, Ricardo},
  date = {2023-07-01},
  journaltitle = {Sustainable Production and Consumption},
