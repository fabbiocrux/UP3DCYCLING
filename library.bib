@article{flood2023,
  title = {Imagining Climate Resilient Futures: {{A}} Layered {{Delphi}} Panel Approach},
  shorttitle = {Imagining Climate Resilient Futures},
  author = {Flood, Stephen and Rogan, Fionn and Revez, Alexandra and McGookin, Connor and O'Dwyer, Barry and Harris, Clodagh and Dunphy, Niall and Byrne, Edmond and Gallach\'oir, Brian \'O and Bolger, Paul and Boyle, Evan and Glynn, James and Barry, John and Ellis, Geraint and Mullally, Gerard},
  date = {2023-03-01},
