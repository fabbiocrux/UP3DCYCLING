@article{kok2023,
  title = {Exploring the Practice of {{Labs}} for Sustainable Transformation: {{The}} Challenge of `Creating Impact'},
  shorttitle = {Exploring the Practice of {{Labs}} for Sustainable Transformation},
  author = {Kok, Kristiaan P. W. and family=Meij, given=Marjoleine G., prefix=van der, useprefix=true and Wagner, Petra and Cesuroglu, Tomris and Broerse, Jacqueline E. W. and Regeer, Barbara J.},
  date = {2023-02-15},
  journaltitle = {Journal of Cleaner Production},
  shortjournal = {J. Clean. Prod.},
  volume = {388},
  pages = {135994},
  issn = {0959-6526},
  doi = {10.1016/j.jclepro.2023.135994},
