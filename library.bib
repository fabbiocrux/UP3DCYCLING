  shorttitle = {The Sustainability Paradox},
  author = {Squalli, Jay},
  date = {2025-09-01},
  journaltitle = {Journal of Cleaner Production},
  shortjournal = {J. Clean. Prod.},
  volume = {522},
  pages = {146283},
  issn = {0959-6526},
  doi = {10.1016/j.jclepro.2025.146283},
  url = {https://www.sciencedirect.com/science/article/pii/S0959652625016336},
  urldate = {2025-09-01},
  abstract = {This study investigates the moral and psychological correlates of organic food consumption, focusing on distinctions among altruistic, egoistic, and hypocritical motivations. Using U.S. state-level data and multivariate regression, including M-estimator-based Huber models and Bootstrap inference, the analysis evaluates the extent to which these moral narratives are associated with organic food purchasing patterns, net of other factors. The results indicate a positive association between environmental altruism, proxied by collective environmental values, and higher rates of organic food consumption. By contrast, egoistic motivations, particularly state-level indicators of health concerns linked to pollution exposure, do not show a statistically significant relationship with organic food consumption. The analysis also finds no evidence of environmental hypocrisy, as observed purchasing behaviors largely align with pro-environmental attitudes. These findings suggest that collective environmental values correspond more closely with organic purchasing patterns than egoistic considerations. The study highlights the relevance of public policies aimed at strengthening environmental values and shared responsibility to support sustainable consumption.},
  file = {/Users/FabioCruz/Zotero/storage/ZA9PZS6V/S0959652625016336.html}
}

