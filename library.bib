  file = {/Users/FabioCruz/Zotero/storage/RL5AATWB/Chen et al_2023_Probabilistic material flow analysis of eight commodity plastics in China.pdf;/Users/FabioCruz/Zotero/storage/JM6EMYQA/S0921344923000174.html}
