@article{avelino2024,
  title = {Just Sustainability Transitions: Politics, Power, and Prefiguration in Transformative Change Toward Justice and Sustainability},
  shorttitle = {Just Sustainability Transitions},
  author = {Avelino, Flor and Wijsman, Katinka and family=Steenbergen, given=Frank, prefix=van, useprefix=false and Jhagroe, Shivant and Wittmayer, Julia and Akerboom, Sanne and Bogner, Kristina and Jansen, Esther F. and Frantzeskaki, Niki and Kalfagianni, Agni},
  date = {2024-10-18},
  journaltitle = {Annual Review of Environment and Resources},
