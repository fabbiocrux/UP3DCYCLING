  author = {Ferrante, Mariantonietta and Vitti, Micaela and Facchini, Francesco and Sassanelli, Claudio},
  date = {2024-06-01},
  journaltitle = {Journal of Cleaner Production},
  shortjournal = {J. Clean. Prod.},
  volume = {456},
