@article{carvalho2022,
  title = {Nature-Based Solutions Addressing the Water-Energy-Food Nexus: {{Review}} of Theoretical Concepts and Urban Case Studies},
  author = {Carvalho, Pedro N. and Finger, David Christian and Masi, Fabio and Cipolletta, Giulia and Oral, Hasan Volkan and T\'oth, Attila and Regelsberger, Martin and Exposito, Alfonso},
  date = {2022-03-01},
