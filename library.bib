@article{lyu2026,
  title = {A Decision-Support Framework for Early-Stage Screening of Sustainable and Degradable Plastics in a Circular Economy},
  author = {Lyu, Linxiang and Markoglou, Nektaria and Bagchi, Monisha and Wan, Shuyan and Bi, Huifang and Yang, Xiaohan and Wang, Ziyu and Chen, Zhikun and An, Chunjiang},
  date = {2026-04-15},
  journaltitle = {Resources, Conservation and Recycling},
  shortjournal = {Resour. Conserv. Recycl.},
  volume = {230},
  pages = {108881},
  issn = {0921-3449},
  doi = {10.1016/j.resconrec.2026.108881},
  url = {https://www.sciencedirect.com/science/article/pii/S0921344926001059},
  urldate = {2026-03-10},
  abstract = {Plastic pollution presents a significant and persistent threat to ecosystems. Degradable plastics are promising, yet their degradation varies widely depending on material properties and environmental conditions. Accurate prediction of environmental degradation is essential for advancing sustainable design and regulatory evaluation. We proposed a two-stage framework integrating MCDA with machine learning models to predict degradation rates in soil and seawater. Amongst these models, a depth-3 decision tree achieved the best accuracy. Sensitivity and robustness analyses highlighted the importance of molecular weight and functional-group features and confirmed the consistency of the entropy-weighted WSM configuration. Sensitivity and robustness analyses confirmed the effectiveness of Entropy weighting and WSM-based scoring in improving model stability and predictability. The framework enables early-stage, decision-relevant screening of diverse plastic materials. We outline a screening workflow that couples model outputs with experimental validation and standard protocols, supporting sustainable materials selection aligned with circular-economy goals.},
  file = {/Users/FabioCruz/Zotero/storage/QX3DGU3W/Lyu et al. - 2026 - A decision-support framework for early-stage screening of sustainable and degradable plastics in a c.pdf;/Users/FabioCruz/Zotero/storage/5MYBQMM3/S0921344926001059.html}
}

