@article{le2020,
  title = {Methyltrimethoxysilane-Coated Recycled Polyethylene Terephthalate Aerogels for Oil Spill Cleaning Applications},
  author = {Le, Duyen Khac and Ng, Gek Nian and Koh, Hong Wei and Zhang, Xiwen and Thai, Quoc Ba and Phan-Thien, Nhan and Duong, Hai Minh},
