  date = {2025-04-02},
  journaltitle = {Journal of Cleaner Production},
  shortjournal = {J. Clean. Prod.},
  pages = {145440},
  issn = {0959-6526},
  doi = {10.1016/j.jclepro.2025.145440},
  url = {https://www.sciencedirect.com/science/article/pii/S0959652625007905},
  urldate = {2025-04-07},
  abstract = {The Doughnut conceptual framework, originally developed by the economist Kate Raworth, delineates a ``safe and just space'' for human activities, located between a social foundation and an ecological ceiling. A targeted literature review shows that over the past decade this visually appealing, holistic and scientifically grounded framework has gained attention for its potential to guide socio-ecological transitions globally. At the same time, it has faced various theoretical critiques related to its scientific validity, social justice considerations, and challenges in local adaptations. Drawing from two action research projects conducted in Switzerland using specific approaches for its practical applications at the local level---the Doughnut Unrolled methodology and the Data Portrait quantification---this article seeks to bring clarity to the critiques often directed at the Doughnut, distinguishing those that refer to the Doughnut framework from those arising when attempting to implement it locally. Moreover, it identifies the difficulties in maintaining the integrity of the framework and its strong sustainability principles when applied to regional or municipal scales, thus contributing to the discussion on the often-overlooked gap between the global conceptual framework and its practical implementation at the local level, particularly in Global North contexts. To address this and avoid any kind of ``Doughnut-washing'', we propose six guiding principles for maintaining the framework's integrity in local implementations. By applying these principles, we argue that the Doughnut framework can retain its transformative potential while remaining scientifically robust and actionable at various governance scales.},
  file = {/Users/FabioCruz/Zotero/storage/PAYTXP46/S0959652625007905.html}
}

