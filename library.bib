  author = {Nguyen, Hieu Tri and Crittenden, Kelly and Weiss, Leland and Bardaweel, Hamzeh},
  date = {2022-09-25},
  journaltitle = {Journal of Cleaner Production},
  shortjournal = {J. Clean. Prod.},
