  title = {Life Cycle Assessment of Filament Production in Distributed Plastic Recycling via Additive Manufacturing},
  author = {Caceres-Mendoza, Cristian and Santander-Tapia, Pavlo and Cruz Sanchez, Fabio A. and Troussier, Nad\`ege and Camargo, Mauricio and Boudaoud, Hakim},
  date = {2023-08-01},
  journaltitle = {Cleaner Waste Systems},
  shortjournal = {Clean. Waste Syst.},
