@article{aschemann-witzel2023,
  title = {Outside-in and Bottom-up: {{Using}} Sustainability Transitions to Understand the Development Phases of Mainstreaming Plant-Based in the Food Sector in a Meat and Dairy Focused Economy},
  shorttitle = {Outside-in and Bottom-Up},
  author = {Aschemann-Witzel, Jessica and Mulders, Maartje D. G. H. and Mouritzen, Simone Lykke Tranholm},
