@article{mendoza2025,
  title = {An {{Integrated Framework}} for {{Post-Consumer Plastic Waste Management}} in {{Europe}}: {{Indicators}} and {{Macro-Environmental Barriers}}},
  shorttitle = {An {{Integrated Framework}} for {{Post-Consumer Plastic Waste Management}} in {{Europe}}},
  author = {Mendoza, Cristian Caceres and Cruz Sanchez, Fabio A. and Cluzel, Fran\c cois and Leroy, Yann and Boudaoud, Hakim},
  date = {2025},
  journaltitle = {Procedia CIRP},
  volume = {135},
