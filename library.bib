@article{thomas2014,
  title = {{{3D}} Additive Manufacture of Oral and Maxillofacial Surgical Models for Preoperative Planning},
  author = {Thomas, D. J. and Azmi, M. A.B.Mohd B. Mohd and Tehrani, Z.},
