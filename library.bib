@article{wagner2020,
  ids = {wagner2020a},
  title = {Legacy Additives in a Circular Economy of Plastics: {{Current}} Dilemma, Policy Analysis, and Emerging Countermeasures},
  author = {Wagner, Swetlana and Schlummer, Martin},
