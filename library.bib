  title = {Life Cycle Assessment of Single-Use Surgical and Embedded Filtration Layer ({{EFL}}) Reusable Face Mask},
  author = {Lee, Amos Wei Lun and Neo, Edward Ren Kai and Khoo, Zi-Yu and Yeo, Zhiquan and Tan, Yee Shee and Chng, Shuyun and Yan, Wenjin and Lok, Boon Keng and Low, Jonathan Sze Choong},
  date = {2021-07-01},
  journaltitle = {Resources, Conservation and Recycling},
