@article{hapuwatte2021,
  title = {Closed-Loop Sustainable Product Design for Circular Economy},
  author = {Hapuwatte, Buddhika M. and Jawahir, I. S.},
  date = {2021-12-01},
  journaltitle = {Journal of Industrial Ecology},
  shortjournal = {J. Ind. Ecol.},
  volume = {25},
  number = {6},
  pages = {1430--1446},
  publisher = {John Wiley \& Sons, Ltd},
