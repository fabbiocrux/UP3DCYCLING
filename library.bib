  title = {From {{Trash}} to {{Treasure}}: {{Assessing}} the {{Effectiveness}} of the {{Green}}@{{Community Recycling Network}} in {{Hong Kong}}},
  shorttitle = {From {{Trash}} to {{Treasure}}},
  author = {Chan, Teressa H. C. and Hui, Tin Yan and Chan, Janet K. Y.},
  date = {2024-12},
